@startuml ManettaDualSm

' Rendering only. StateSmith's PlantUML grammar doesn't know `left to right direction`, so it is wrapped in an ignore block.
' <StateSmith:ignore>
left to right direction
' </StateSmith:ignore>
skinparam defaultFontSize 13

' Cut-down Manetta controller for a DUAL BOILER machine (device side). Portable code + orthogonal regions.
'
' The brew side and the steam boiler really run in parallel here (steam milk while a shot is pulled), so ON has
' two regions (the `--` line):
'   STEAM BOILER region  STEAM_OFF / STEAM_ON {STEAM_HEATING, STEAM_READY}; its own sensor (STEAM_TEMP_*), its own caps
'   BREW region          IDLE / BREWING / FAULT; the brew boiler's sensor (TEMP_*) drives `power`
' An event goes to every region (steam boiler first, then brew), and to ON / the root only if no region consumed it.
'
' Rules BETWEEN the regions are written with `in_state(...)`:
'   - brew priority (shared power budget): the steam heater pauses while the pump runs
'   - a fault (brew region) refuses ENTER_STEAM and the steam button
'   - auto-off never fires during a brew
' Everything else (types, variables, time helpers, host calls, typed events) works like ManettaSm.plantuml.

/'! $CONFIG : toml
[RenderConfig]
FileTop = "// Generated by StateSmith from ManettaDualSm.plantuml (portable code, orthogonal regions). Do not edit."

[RenderConfig.Portable]
Types = """
enum Reply { NONE, OK, BUSY, NOT_READY, FAULT, INVALID }
enum Phase { IDLE, BREWING, FAULT }
enum Power { OFF, HEATING, READY, COOLING, ON }
enum SteamState { OFF, HEATING, READY }
enum StopReason { NONE, APP, MACHINE, COMMAND_CAP, DEVICE_CAP, LINK_LOST, HEARTBEAT, FAULT }
enum StartSource { NONE, APP, MACHINE }
"""
Functions = """
void set_pump(bool on);              // brew pump
void set_power_relay(bool on);       // boiler power relay
void set_steam_heater(bool on);       // steam boiler heater
"""
Events = """
START_BREW(uint max_ms)              // command cap for this brew
ENTER_STEAM(uint max_ms)             // command cap for this steam session
"""
Variables = """
// ---- inputs written by the host ----
uint now_ms = 0;                     // monotonic ms, set before every dispatch
uint last_write_at = 0;              // now_ms of the last BLE write
// ---- device configuration ----
uint device_max_brew_ms = 1800000;   // at most 30 min
uint device_max_steam_ms = 600000;   // counts from when steam was switched on
uint heartbeat_timeout_ms = 10000;   // 5 s to 60 s, app-started brews only
uint auto_off_min = 30;
// ---- outputs ----
Reply reply = Reply.NONE;            // answer to the last command
Phase phase = Phase.IDLE;
Power power = Power.OFF;
SteamState steam_state = SteamState.OFF;
StopReason stop_reason = StopReason.NONE;
StartSource start_source = StartSource.NONE;
// ---- internal ----
uint brew_cmd_max_ms = 0;
uint steam_cmd_at = 0;               // last ENTER_STEAM (a repeat restarts the command cap)
uint steam_cmd_max_ms = 0;
uint auto_off_from = 0;              // later of the last TURN_ON and the end of the last brew
"""
'/


' ////////////////////////////// STATES //////////////////////////////

[*] --> OFF
state OFF
state ON {
    [*] --> STEAM_OFF
    state STEAM_OFF
    state STEAM_ON {
        [*] --> STEAM_HEATING
        state STEAM_HEATING
        state STEAM_READY
    }
    --
    [*] --> IDLE
    state IDLE
    state BREWING
    state FAULT
    ' The brew region's transitions are written in here: PlantUML can't draw a transition written outside `ON { }`
    ' that starts or ends in a second (or later) region, nor one from such a region to a state outside `ON`.
    ' StateSmith accepts all of these.
    IDLE --> BREWING : 3. START_BREW [max_ms != 0 && power == Power.READY] / reply = Reply.OK; start_source = StartSource.APP; brew_cmd_max_ms = max_ms;
    IDLE --> BREWING : MACHINE_BREW_SWITCH_ON / start_source = StartSource.MACHINE;
    IDLE --> FAULT : FAULT_DETECTED
    BREWING --> IDLE : 1. after(brew_cmd_max_ms) [start_source == StartSource.APP] / stop_reason = StopReason.COMMAND_CAP;
    BREWING --> IDLE : 2. after(device_max_brew_ms) / stop_reason = StopReason.DEVICE_CAP;
    BREWING --> IDLE : 3. do [start_source == StartSource.APP && elapsed(last_write_at) >= heartbeat_timeout_ms] / stop_reason = StopReason.HEARTBEAT;
    BREWING --> IDLE : STOP_BREW / reply = Reply.OK; stop_reason = StopReason.APP;
    BREWING --> IDLE : MACHINE_BREW_SWITCH_OFF / stop_reason = StopReason.MACHINE;
    BREWING --> IDLE : LINK_LOST [start_source == StartSource.APP] / stop_reason = StopReason.LINK_LOST;
    BREWING --> FAULT : FAULT_DETECTED / stop_reason = StopReason.FAULT;
    FAULT --> IDLE : FAULT_CLEARED / phase = Phase.IDLE;
}

' ////////////////// ROOT: true in every state unless a child overrides it //////////////////

ManettaDualSm : PING / reply = Reply.OK;
ManettaDualSm : STOP_BREW / reply = Reply.OK;
ManettaDualSm : LEAVE_STEAM / reply = Reply.OK;

' ////////////////////////////// OFF //////////////////////////////
' A fault while off is a flag (`phase == Phase.FAULT`), not a state. Turning on is refused while it is active.

OFF : enter / set_power_relay(false); power = Power.OFF;
OFF : TURN_OFF / reply = Reply.OK;
OFF : 1. (TURN_ON, START_BREW, ENTER_STEAM) [phase == Phase.FAULT] / reply = Reply.FAULT;
OFF : 2. (START_BREW, ENTER_STEAM) [phase != Phase.FAULT] / reply = Reply.NOT_READY;
OFF --> ON : 3. TURN_ON [phase != Phase.FAULT] / reply = Reply.OK;
OFF --> ON : MACHINE_POWER_SWITCH [phase != Phase.FAULT]
OFF : FAULT_DETECTED / phase = Phase.FAULT;
OFF : FAULT_CLEARED / phase = Phase.IDLE;

' ////////////////////////////// ON (both regions run inside it) //////////////////////////////

ON : enter / set_power_relay(true); power = Power.HEATING; auto_off_from = now_ms;
ON : TURN_ON / reply = Reply.OK; auto_off_from = now_ms;
ON : TEMP_HEATING / power = Power.HEATING;
ON : TEMP_READY / power = Power.READY;
ON : TEMP_TOO_HOT / power = Power.COOLING;
ON --> OFF : TURN_OFF / reply = Reply.OK;
' (`BREWING --> OFF` would say the same, but PlantUML can't draw it: the guard is checked before anything exits.)
ON --> OFF : 1. MACHINE_POWER_SWITCH [in_state(BREWING)] / stop_reason = StopReason.MACHINE;
ON --> OFF : 2. MACHINE_POWER_SWITCH
' Auto-off: steam doesn't hold it off, a fault doesn't either, a brew does.
ON --> OFF : do [!in_state(BREWING) && elapsed(auto_off_from) >= auto_off_min * 60000]

' ////////////////////////////// STEAM BOILER region //////////////////////////////

STEAM_OFF : 1. ENTER_STEAM [max_ms == 0] / reply = Reply.INVALID;
STEAM_OFF : 2. ENTER_STEAM [max_ms != 0 && in_state(FAULT)] / reply = Reply.FAULT;
STEAM_OFF --> STEAM_ON : 3. ENTER_STEAM [max_ms != 0 && !in_state(FAULT)] / reply = Reply.OK; steam_cmd_max_ms = max_ms;
STEAM_OFF --> STEAM_ON : MACHINE_STEAM_BUTTON [!in_state(FAULT)] / steam_cmd_max_ms = device_max_steam_ms;

' Brew priority: the heater only runs while no brew is pulling power (BREWING turns it back on when it ends).
STEAM_ON : enter / set_steam_heater(!in_state(BREWING)); steam_cmd_at = now_ms;
STEAM_ON : exit / set_steam_heater(false); steam_state = SteamState.OFF;
STEAM_ON : 1. ENTER_STEAM [max_ms == 0] / reply = Reply.INVALID;
STEAM_ON : 2. ENTER_STEAM [max_ms != 0] / reply = Reply.OK; steam_cmd_max_ms = max_ms; steam_cmd_at = now_ms;
STEAM_ON --> STEAM_OFF : LEAVE_STEAM / reply = Reply.OK;
STEAM_ON --> STEAM_OFF : MACHINE_STEAM_BUTTON
STEAM_ON --> STEAM_OFF : FAULT_DETECTED
STEAM_ON --> STEAM_OFF : 1. do [elapsed(steam_cmd_at) >= steam_cmd_max_ms]
STEAM_ON --> STEAM_OFF : 2. after(device_max_steam_ms)

STEAM_HEATING : enter / steam_state = SteamState.HEATING;
STEAM_HEATING --> STEAM_READY : STEAM_TEMP_READY
STEAM_READY : enter / steam_state = SteamState.READY;
STEAM_READY --> STEAM_HEATING : STEAM_TEMP_HEATING

' ////////////////////////////// BREW region //////////////////////////////
' Brewing needs the brew boiler READY. Steam no longer matters: it has its own boiler.
' (Its transitions are inside `state ON { }` above, see the note there.)

IDLE : 1. START_BREW [max_ms == 0] / reply = Reply.INVALID;
IDLE : 2. START_BREW [max_ms != 0 && power != Power.READY] / reply = Reply.NOT_READY;

BREWING : enter / phase = Phase.BREWING; stop_reason = StopReason.NONE; set_pump(true); set_steam_heater(false);
BREWING : exit / set_pump(false); set_steam_heater(in_state(STEAM_ON)); phase = Phase.IDLE; auto_off_from = now_ms;
BREWING : TURN_OFF / reply = Reply.BUSY;
BREWING : START_BREW / reply = Reply.BUSY;

FAULT : enter / phase = Phase.FAULT;
FAULT : (TURN_ON, START_BREW) / reply = Reply.FAULT;
FAULT : FAULT_DETECTED

@enduml
