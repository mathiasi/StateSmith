@startuml ManettaSm

' Rendering only. Left-to-right keeps the many IDLE <-> BREWING / STEAM edges readable.
' StateSmith's PlantUML grammar doesn't know `left to right direction`, so it is wrapped in an ignore block.
' <StateSmith:ignore>
left to right direction
' </StateSmith:ignore>
skinparam defaultFontSize 13

' Cut-down Manetta espresso machine controller (device side). NORTH STAR version: portable code.
'
' ONE diagram generates both Rust (board, no_std) and TypeScript (iPad app). Everything the
' generator needs is in this file: the types, variables and host functions are declared below (in the $CONFIG block),
' and all action / guard code is "portable code" that StateSmith translates for each language:
'   - `reply = Reply.OK;`  `power == Power.READY`   plain code on declared variables
'   - `set_pump(true);`    calls a declared host function (Rust: trait the machine is generic over; TS: interface)
'   - `after(ms)`          trigger: fires once `ms` have passed since this state was entered
'                         (StateSmith records the entry time; checked on every `do` tick)
'   - `elapsed(t)`         time since timestamp `t`
'   Time math is unsigned and wraps like the device's u32 millisecond counter, in every language.
'
' Host contract: set `now_ms` and dispatch `do` every 100 ms tick; set `last_write_at = now_ms` on
' every BLE write (any write is a heartbeat). Commands with data use the generated typed dispatchers,
' e.g. `dispatch_start_brew(max_ms)`, and diagram code reads the argument as `max_ms`.
'
' Parallel concerns are variables + guards (StateSmith has no regions):
'   temperature  -> `power` (HEATING / READY / COOLING), updated by TEMP_* events in ON
'   auto-off     -> `auto_off_from` timestamp + `do` guard
'   faults       -> FAULT sub state of ON while on; `phase == Phase.FAULT` while off

/'! $CONFIG : toml
[RenderConfig]
FileTop = "// Generated by StateSmith from ManettaSm.plantuml (portable code). Do not edit."

[RenderConfig.Portable]
Types = """
enum Reply { NONE, OK, BUSY, NOT_READY, FAULT, INVALID }
enum Phase { IDLE, BREWING, FAULT }
enum Power { OFF, HEATING, READY, COOLING, ON }
enum SteamState { OFF, HEATING, READY }
enum StopReason { NONE, APP, MACHINE, COMMAND_CAP, DEVICE_CAP, LINK_LOST, HEARTBEAT, FAULT }
enum StartSource { NONE, APP, MACHINE }
"""
Functions = """
void set_pump(bool on);              // brew pump
void set_power_relay(bool on);       // boiler power relay
void set_steam_heater(bool on);
"""
Events = """
START_BREW(uint max_ms)              // command cap for this brew
ENTER_STEAM(uint max_ms)             // command cap for this steam session
"""
Variables = """
// ---- inputs written by the host ----
uint now_ms = 0;                     // monotonic ms, set before every dispatch
uint last_write_at = 0;              // now_ms of the last BLE write
// ---- device configuration ----
uint device_max_brew_ms = 1800000;   // at most 30 min
uint device_max_steam_ms = 600000;   // counts from when steam began
uint heartbeat_timeout_ms = 10000;   // 5 s to 60 s, app-started brews only
uint auto_off_min = 30;
// ---- outputs ----
Reply reply = Reply.NONE;            // answer to the last command
Phase phase = Phase.IDLE;
Power power = Power.OFF;
SteamState steam_state = SteamState.OFF;
StopReason stop_reason = StopReason.NONE;
StartSource start_source = StartSource.NONE;
// ---- internal ----
uint brew_cmd_max_ms = 0;
uint steam_cmd_at = 0;               // last ENTER_STEAM (a repeat restarts the command cap)
uint steam_cmd_max_ms = 0;
uint auto_off_from = 0;              // later of the last TURN_ON and the end of the last brew
"""
'/

' ////////////////////////////// STATES //////////////////////////////

[*] --> OFF
state OFF
state ON {
    [*] --> IDLE
    state IDLE
    state BREWING
    state STEAM {
        [*] --> STEAM_HEATING
        state STEAM_HEATING
        state STEAM_READY
    }
    state FAULT
}

' A fault doesn't replace the power state, it sits beside it:
'   - while ON, FAULT is a sub state of ON, so everything ON does (auto-off, temperature, power switch, TURN_OFF) keeps working;
'   - while OFF, the machine stays in OFF and `phase` reports FAULT.
' `phase == Phase.FAULT` is the one fault flag. Only FAULT_CLEARED resets it, so a fault survives turning off.

' ////////////////// ROOT (the machine itself): true in every state unless a child overrides it //////////////////

ManettaSm : PING / reply = Reply.OK;
ManettaSm : STOP_BREW / reply = Reply.OK;
ManettaSm : LEAVE_STEAM / reply = Reply.OK;

' ////////////////////////////// OFF //////////////////////////////
' A fault while off is a flag, not a state. Turning on is refused while a fault is active, both from the app (reply FAULT)
' and from the machine's own power switch (ignored): heating a machine that reports a fault is the unsafe choice.

OFF : enter / set_power_relay(false); power = Power.OFF;
OFF : TURN_OFF / reply = Reply.OK;
OFF : 1. (TURN_ON, START_BREW, ENTER_STEAM) [phase == Phase.FAULT] / reply = Reply.FAULT;
OFF : 2. (START_BREW, ENTER_STEAM) [phase != Phase.FAULT] / reply = Reply.NOT_READY;
OFF --> ON : 3. TURN_ON [phase != Phase.FAULT] / reply = Reply.OK;
OFF --> ON : MACHINE_POWER_SWITCH [phase != Phase.FAULT]
OFF : FAULT_DETECTED / phase = Phase.FAULT;
OFF : FAULT_CLEARED / phase = Phase.IDLE;

' ////////////////////////////// ON //////////////////////////////
' Default answers while on. Children override them.

ON : enter / set_power_relay(true); power = Power.HEATING; auto_off_from = now_ms;
ON : TURN_ON / reply = Reply.OK; auto_off_from = now_ms;
ON : (START_BREW, ENTER_STEAM) / reply = Reply.BUSY;
ON : TEMP_HEATING / power = Power.HEATING;
ON : TEMP_READY / power = Power.READY;
ON : TEMP_TOO_HOT / power = Power.COOLING;
ON --> OFF : TURN_OFF / reply = Reply.OK;
ON --> OFF : MACHINE_POWER_SWITCH
ON --> FAULT : FAULT_DETECTED
' Auto-off: once, for every ON sub state (idle, steam, fault), never during a brew.
ON --> OFF : do [phase != Phase.BREWING && elapsed(auto_off_from) >= auto_off_min * 60000]


' ////////////////////////////// IDLE //////////////////////////////
' Brewing needs READY. Heating and cooling (after steam) both answer NOT_READY.
' Steam is allowed while READY or COOLING, not while still HEATING after turn-on.

IDLE : 1. START_BREW [max_ms == 0] / reply = Reply.INVALID;
IDLE : 2. START_BREW [max_ms != 0 && power != Power.READY] / reply = Reply.NOT_READY;
IDLE --> BREWING : 3. START_BREW [max_ms != 0 && power == Power.READY] / reply = Reply.OK; start_source = StartSource.APP; brew_cmd_max_ms = max_ms;
IDLE --> BREWING : MACHINE_BREW_SWITCH_ON / start_source = StartSource.MACHINE;

IDLE : 1. ENTER_STEAM [max_ms == 0] / reply = Reply.INVALID;
IDLE : 2. ENTER_STEAM [max_ms != 0 && power == Power.HEATING] / reply = Reply.NOT_READY;
IDLE --> STEAM : 3. ENTER_STEAM [max_ms != 0 && power != Power.HEATING] / reply = Reply.OK; steam_cmd_max_ms = max_ms;
IDLE --> STEAM : MACHINE_STEAM_BUTTON [power != Power.HEATING] / steam_cmd_max_ms = device_max_steam_ms;

' ////////////////////////////// BREWING //////////////////////////////

BREWING : enter / phase = Phase.BREWING; stop_reason = StopReason.NONE; set_pump(true);
BREWING : exit / set_pump(false); phase = Phase.IDLE; auto_off_from = now_ms;
BREWING : TURN_OFF / reply = Reply.BUSY;

BREWING --> IDLE : 1. after(brew_cmd_max_ms) [start_source == StartSource.APP] / stop_reason = StopReason.COMMAND_CAP;
BREWING --> IDLE : 2. after(device_max_brew_ms) / stop_reason = StopReason.DEVICE_CAP;
BREWING --> IDLE : 3. do [start_source == StartSource.APP && elapsed(last_write_at) >= heartbeat_timeout_ms] / stop_reason = StopReason.HEARTBEAT;
BREWING --> IDLE : STOP_BREW / reply = Reply.OK; stop_reason = StopReason.APP;
BREWING --> IDLE : MACHINE_BREW_SWITCH_OFF / stop_reason = StopReason.MACHINE;
BREWING --> IDLE : LINK_LOST [start_source == StartSource.APP] / stop_reason = StopReason.LINK_LOST;
BREWING --> OFF : MACHINE_POWER_SWITCH / stop_reason = StopReason.MACHINE;
BREWING --> FAULT : FAULT_DETECTED / stop_reason = StopReason.FAULT;

' ////////////////////////////// STEAM //////////////////////////////
' Single heater: while steaming the boiler is "ON" (steam temperature), so the
' brew temperature events are ignored. Leaving steam means the boiler must cool.
' LINK_LOST is deliberately not handled: steam survives a lost link.

STEAM : enter / set_steam_heater(true); power = Power.ON; steam_cmd_at = now_ms;
STEAM : exit / set_steam_heater(false); steam_state = SteamState.OFF; power = Power.COOLING;
STEAM : (TEMP_HEATING, TEMP_READY, TEMP_TOO_HOT)
STEAM : 1. ENTER_STEAM [max_ms == 0] / reply = Reply.INVALID;
STEAM : 2. ENTER_STEAM [max_ms != 0] / reply = Reply.OK; steam_cmd_max_ms = max_ms; steam_cmd_at = now_ms;

STEAM --> IDLE : LEAVE_STEAM / reply = Reply.OK;
STEAM --> IDLE : MACHINE_STEAM_BUTTON
STEAM --> IDLE : 1. do [elapsed(steam_cmd_at) >= steam_cmd_max_ms]
STEAM --> IDLE : 2. after(device_max_steam_ms)

STEAM_HEATING : enter / steam_state = SteamState.HEATING;
STEAM_HEATING --> STEAM_READY : TEMP_READY
STEAM_READY : enter / steam_state = SteamState.READY;

' ////////////////////////////// FAULT (while on) //////////////////////////////
' Entering FAULT exits BREWING / STEAM, so their exit actions turn the pump and steam heater off.
' Everything else (auto-off, temperature, TURN_OFF, the power switch) is handled by ON.

FAULT : enter / phase = Phase.FAULT;
FAULT : (TURN_ON, START_BREW, ENTER_STEAM) / reply = Reply.FAULT;
FAULT : FAULT_DETECTED
FAULT --> IDLE : FAULT_CLEARED / phase = Phase.IDLE;

@enduml
